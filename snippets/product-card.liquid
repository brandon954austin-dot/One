{%- comment -%}
  Product card with ONE clean price (fixes the old theme's duplicated
  "Regular price ... Regular price Sale price ..." bug) and no bogus
  "Sale Sold out" badges on in-stock items.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
<a href="{{ product.url }}" class="card product-card">
  {%- if product.tags contains 'consult' -%}
    <span class="badge">Custom-built</span>
  {%- endif -%}

  {%- if product.featured_image -%}
    <img
      class="product-card__img"
      src="{{ product.featured_image | image_url: width: 640 }}"
      alt="{{ product.featured_image.alt | default: product.title | escape }}"
      loading="lazy"
      width="640"
      height="480"
    >
  {%- else -%}
    <div class="product-card__img--placeholder" aria-hidden="true">
      <svg width="56" height="56" viewBox="0 0 48 48" fill="none">
        <defs>
          <linearGradient id="amaCardNavy" x1="12" y1="14" x2="18" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#10154f"/>
            <stop offset="1" stop-color="#1d2a9e"/>
          </linearGradient>
          <linearGradient id="amaCardBlue" x1="21" y1="14" x2="19" y2="27" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2f45f0"/>
            <stop offset="1" stop-color="#2438cf"/>
          </linearGradient>
          <linearGradient id="amaCardGreen" x1="34" y1="10" x2="18" y2="33" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#38df85"/>
            <stop offset="0.75" stop-color="#2bd473"/>
            <stop offset="1" stop-color="#25c4a0"/>
          </linearGradient>
        </defs>
        <path d="M12.5 18.5 L19 31.5" stroke="url(#amaCardNavy)" stroke-width="11.5" stroke-linecap="round"/>
        <path d="M20.5 16 L20 23" stroke="url(#amaCardBlue)" stroke-width="12.5" stroke-linecap="round"/>
        <path d="M33.5 13 L19.5 31.5" stroke="url(#amaCardGreen)" stroke-width="13" stroke-linecap="round"/>
      </svg>
    </div>
  {%- endif -%}

  <h3>{{ product.title }}</h3>

  <div class="price">
    {%- if product.compare_at_price > product.price -%}
      {{ product.price | money }} <s>{{ product.compare_at_price | money }}</s>
    {%- elsif product.price_varies -%}
      From {{ product.price_min | money }}
    {%- else -%}
      {{ product.price | money }}
    {%- endif -%}
  </div>

  <p>{{ product.description | strip_html | truncate: 120 }}</p>

  {%- if product.tags contains 'consult' -%}
    <span class="btn btn--outline">Program details</span>
  {%- elsif product.available -%}
    <span class="btn btn--outline">View &amp; buy</span>
  {%- else -%}
    <span class="btn btn--outline">Sold out</span>
  {%- endif -%}
</a>
