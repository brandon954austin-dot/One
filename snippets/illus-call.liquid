{%- comment -%}
  Book-a-call illustration: calendar with a confirmed slot and phone
  chip. Decorative brand imagery for the contact page. Wrap in an
  aria-hidden container.
{%- endcomment -%}
<svg viewBox="0 0 360 260" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 100%; height: auto;">
  <defs>
    <linearGradient id="icCalHead" x1="60" y1="30" x2="300" y2="80" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#13315c"/>
      <stop offset="1" stop-color="#0b2545"/>
    </linearGradient>
    <linearGradient id="icBadge" x1="240" y1="150" x2="330" y2="240" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#38df85"/>
      <stop offset="1" stop-color="#25c4a0"/>
    </linearGradient>
  </defs>

  <!-- calendar body -->
  <rect x="58" y="34" width="244" height="196" rx="14" fill="#ffffff" stroke="#dde5ec" stroke-width="1.5"/>
  <rect x="58" y="34" width="244" height="52" rx="14" fill="url(#icCalHead)"/>
  <rect x="58" y="72" width="244" height="14" fill="url(#icCalHead)"/>
  <rect x="92" y="22" width="10" height="26" rx="5" fill="#12a5a0"/>
  <rect x="258" y="22" width="10" height="26" rx="5" fill="#12a5a0"/>
  <rect x="78" y="52" width="90" height="10" rx="5" fill="#ffffff" opacity="0.9"/>

  <!-- day grid -->
  <g fill="#eef3f8">
    <rect x="80" y="102" width="38" height="30" rx="7"/>
    <rect x="128" y="102" width="38" height="30" rx="7"/>
    <rect x="176" y="102" width="38" height="30" rx="7"/>
    <rect x="224" y="102" width="38" height="30" rx="7"/>
    <rect x="80" y="142" width="38" height="30" rx="7"/>
    <rect x="176" y="142" width="38" height="30" rx="7"/>
    <rect x="224" y="142" width="38" height="30" rx="7"/>
    <rect x="80" y="182" width="38" height="30" rx="7"/>
    <rect x="128" y="182" width="38" height="30" rx="7"/>
  </g>

  <!-- booked slot -->
  <rect x="128" y="142" width="38" height="30" rx="7" fill="#2f45f0"/>
  <path d="M138 157.5l5 5 9.5-11" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>

  <!-- confirmed badge -->
  <g transform="translate(238, 152)">
    <circle cx="44" cy="44" r="44" fill="url(#icBadge)"/>
    <circle cx="44" cy="44" r="35" fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="2.2" stroke-dasharray="4 6"/>
    <path d="M28 46l10 10 21-23" stroke="#fff" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- phone chip -->
  <g transform="translate(12, 196)">
    <rect width="132" height="46" rx="12" fill="#ffffff" stroke="#dde5ec"/>
    <circle cx="23" cy="23" r="12" fill="rgba(47,69,240,0.12)"/>
    <path d="M18.5 17.5c0-.8.7-1.5 1.5-1.5h2.2c.7 0 1.3.5 1.5 1.2l.8 3a1.5 1.5 0 0 1-.8 1.7l-1.4.7a10.6 10.6 0 0 0 4.6 4.6l.7-1.4a1.5 1.5 0 0 1 1.7-.8l3 .8c.7.2 1.2.8 1.2 1.5v2.2c0 .8-.7 1.5-1.5 1.5C24 31 18.5 25 18.5 17.5z" fill="#2f45f0"/>
    <text x="44" y="28" font-family="Arial, sans-serif" font-size="13" font-weight="700" fill="#0b2545">Free 15-min call</text>
  </g>
</svg>
