{%- comment -%}
  Survey-ready binder illustration. Decorative brand imagery used on the
  homepage and landing-page heroes. Wrap in an aria-hidden container.
{%- endcomment -%}
<svg viewBox="0 0 440 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="lpCover" x1="90" y1="60" x2="330" y2="360" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#13315c"/>
      <stop offset="1" stop-color="#0b2545"/>
    </linearGradient>
    <linearGradient id="lpSpine" x1="70" y1="60" x2="70" y2="360" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#1d2a9e"/>
      <stop offset="1" stop-color="#10154f"/>
    </linearGradient>
    <linearGradient id="lpBadge" x1="290" y1="260" x2="390" y2="360" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#38df85"/>
      <stop offset="1" stop-color="#25c4a0"/>
    </linearGradient>
    <linearGradient id="lpTab1" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#2f45f0"/><stop offset="1" stop-color="#2438cf"/>
    </linearGradient>
  </defs>

  <!-- pages behind -->
  <rect x="96" y="70" width="252" height="300" rx="10" fill="#e9eef5"/>
  <rect x="90" y="64" width="252" height="300" rx="10" fill="#f6f9fc"/>

  <!-- binder cover -->
  <rect x="82" y="56" width="252" height="304" rx="12" fill="url(#lpCover)"/>
  <rect x="66" y="56" width="30" height="304" rx="10" fill="url(#lpSpine)"/>
  <circle cx="81" cy="120" r="5" fill="#0a1330"/>
  <circle cx="81" cy="208" r="5" fill="#0a1330"/>
  <circle cx="81" cy="296" r="5" fill="#0a1330"/>

  <!-- cover content -->
  <g transform="translate(120, 92)">
    <path d="M8 12 L14 25" stroke="#2f45f0" stroke-width="11" stroke-linecap="round"/>
    <path d="M28 7 L15 25" stroke="#2bd473" stroke-width="12" stroke-linecap="round"/>
    <rect x="46" y="4" width="120" height="10" rx="5" fill="#ffffff" opacity="0.92"/>
    <rect x="46" y="21" width="84" height="8" rx="4" fill="#8fa8c7"/>
  </g>
  <rect x="120" y="150" width="176" height="7" rx="3.5" fill="#3d5a80"/>
  <rect x="120" y="167" width="150" height="7" rx="3.5" fill="#3d5a80"/>
  <rect x="120" y="184" width="163" height="7" rx="3.5" fill="#3d5a80"/>

  <!-- checklist rows on cover -->
  <g transform="translate(120, 214)">
    <circle cx="10" cy="10" r="10" fill="rgba(43,212,115,0.2)"/>
    <path d="M5.5 10.5l3 3 6.5-7" stroke="#2bd473" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="30" y="5" width="120" height="9" rx="4.5" fill="#22406b"/>
  </g>
  <g transform="translate(120, 248)">
    <circle cx="10" cy="10" r="10" fill="rgba(43,212,115,0.2)"/>
    <path d="M5.5 10.5l3 3 6.5-7" stroke="#2bd473" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="30" y="5" width="140" height="9" rx="4.5" fill="#22406b"/>
  </g>
  <g transform="translate(120, 282)">
    <circle cx="10" cy="10" r="10" fill="rgba(43,212,115,0.2)"/>
    <path d="M5.5 10.5l3 3 6.5-7" stroke="#2bd473" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="30" y="5" width="104" height="9" rx="4.5" fill="#22406b"/>
  </g>

  <!-- index tabs -->
  <rect x="330" y="96" width="34" height="26" rx="6" fill="url(#lpTab1)"/>
  <rect x="330" y="136" width="34" height="26" rx="6" fill="#2bd473"/>
  <rect x="330" y="176" width="34" height="26" rx="6" fill="#12a5a0"/>
  <rect x="330" y="216" width="34" height="26" rx="6" fill="#3d5a80"/>

  <!-- floating "Survey-Ready" badge -->
  <g transform="translate(288, 268)">
    <circle cx="52" cy="52" r="52" fill="url(#lpBadge)"/>
    <circle cx="52" cy="52" r="42" fill="none" stroke="#ffffff" stroke-opacity="0.55" stroke-width="2.5" stroke-dasharray="4 6"/>
    <path d="M34 54l12 12 24-26" stroke="#fff" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
  </g>

  <!-- floating stat chip -->
  <g transform="translate(18, 300)">
    <rect width="150" height="58" rx="12" fill="#ffffff"/>
    <text x="16" y="26" font-family="Arial, sans-serif" font-size="17" font-weight="800" fill="#0b2545">30+ years</text>
    <text x="16" y="45" font-family="Arial, sans-serif" font-size="12" fill="#5b6b7d">DMEPOS experience</text>
  </g>

  <!-- floating chip top -->
  <g transform="translate(20, 26)">
    <rect width="176" height="46" rx="12" fill="#ffffff"/>
    <circle cx="23" cy="23" r="11" fill="rgba(43,212,115,0.2)"/>
    <path d="M18 23.5l3.4 3.4 7-7.6" stroke="#25c4a0" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
    <text x="42" y="28" font-family="Arial, sans-serif" font-size="13.5" font-weight="700" fill="#0b2545">Accreditation-ready</text>
  </g>
</svg>
