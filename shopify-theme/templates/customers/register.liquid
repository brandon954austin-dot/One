<section class="section">
  <div class="container" style="max-width: 34rem;">
    <span class="eyebrow">Client portal</span>
    <h1>Create an account</h1>
    <div class="card">
      {% form 'create_customer' %}
        {%- if form.errors -%}
          <div class="form-errors">
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <div class="form-grid">
          <div class="form-field">
            <label for="reg-first">First name</label>
            <input type="text" id="reg-first" name="customer[first_name]" autocomplete="given-name">
          </div>
          <div class="form-field">
            <label for="reg-last">Last name</label>
            <input type="text" id="reg-last" name="customer[last_name]" autocomplete="family-name">
          </div>
          <div class="form-field">
            <label for="reg-email">Email</label>
            <input type="email" id="reg-email" name="customer[email]" required autocomplete="email">
          </div>
          <div class="form-field">
            <label for="reg-password">Password</label>
            <input type="password" id="reg-password" name="customer[password]" required autocomplete="new-password">
          </div>
          <div><button type="submit" class="btn btn--primary">Create account</button></div>
          <p style="margin: 0;">Already have an account? <a href="{{ routes.account_login_url }}">Log in</a></p>
        </div>
      {% endform %}
    </div>
  </div>
</section>
