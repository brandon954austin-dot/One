{%- comment -%}
  Privacy Policy page. Assign in the Shopify admin:
  Online Store → Pages → Privacy Policy → Theme template → "page.privacy".
  Contact details pull from theme settings; bracketed [chips] still need
  real values (legal name, street address, effective date).
{%- endcomment -%}

<style>
  .pp-band { background: linear-gradient(160deg, var(--navy-900), var(--navy-950)); color: #e8eef5; padding-block: clamp(2.4rem, 5vw, 3.6rem); }
  .pp-band h1 { color: #fff; margin-bottom: 0.4rem; }
  .pp-meta { color: #b9c6d6; font-size: 0.95rem; margin: 0; }
  .pp-fill { background: #fff3d6; color: #8a5a00; padding: 1px 7px; border-radius: 5px; font-weight: 600; white-space: nowrap; }
  .pp-band .pp-fill { background: rgba(18, 165, 160, 0.18); color: #7cefc4; }

  .pp-wrap { display: grid; grid-template-columns: 220px 1fr; gap: 3rem; align-items: start; padding-block: 2.5rem 4.5rem; }
  .pp-toc { position: sticky; top: 5.5rem; }
  .pp-toc-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 0.75rem; }
  .pp-toc ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--line); }
  .pp-toc li a { display: block; padding: 0.42rem 0 0.42rem 0.85rem; margin-left: -2px; border-left: 2px solid transparent; color: var(--ink-soft); text-decoration: none; font-size: 0.85rem; font-weight: 500; }
  .pp-toc li a:hover { color: var(--navy-900); border-left-color: var(--teal-500); }

  .pp-item { margin-bottom: 2.3rem; scroll-margin-top: 6rem; }
  .pp-item-head { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.7rem; }
  .pp-badge { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--teal-500); color: var(--navy-900); display: inline-flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700; flex-shrink: 0; }
  .pp-item h2 { font-size: 1.15rem; margin: 0; }
  .pp-item-body { padding-left: 2.5rem; font-size: 0.97rem; }
  .pp-item-body p { margin: 0 0 0.75rem; }
  .pp-item-body ul { margin: 0 0 0.75rem; padding-left: 1.25rem; }
  .pp-item-body li { margin-bottom: 0.4rem; }
  .pp-contact { font-style: normal; padding-left: 2.5rem; font-size: 0.97rem; line-height: 1.8; }
  .pp-intro { font-size: 1.02rem; margin-bottom: 2.4rem; }

  @media (max-width: 720px) {
    .pp-wrap { grid-template-columns: 1fr; gap: 0.5rem; }
    .pp-toc { position: static; }
    .pp-toc ol { border-left: none; display: flex; flex-wrap: wrap; gap: 0.35rem 0.9rem; }
    .pp-toc li a { padding: 0.25rem 0; border-left: none; }
    .pp-item-body, .pp-contact { padding-left: 0; }
  }
</style>

<section class="pp-band">
  <div class="container">
    <span class="eyebrow" style="color: #12a5a0;">Legal</span>
    <h1>{{ page.title | default: 'Privacy Policy' }}</h1>
    <p class="pp-meta">Effective date: <span class="pp-fill">[Insert Effective Date]</span> &nbsp;·&nbsp; Applies to {{ shop.url }}</p>
  </div>
</section>

<div class="container pp-wrap">
  <nav class="pp-toc" aria-label="Table of contents">
    <div class="pp-toc-label">On this page</div>
    <ol>
      <li><a href="#collect">1. Information we collect</a></li>
      <li><a href="#use">2. How we use it</a></li>
      <li><a href="#cookies">3. Cookies &amp; advertising</a></li>
      <li><a href="#share">4. How we share it</a></li>
      <li><a href="#rights">5. Your privacy rights</a></li>
      <li><a href="#retention">6. Data retention</a></li>
      <li><a href="#security">7. Data security</a></li>
      <li><a href="#children">8. Children's privacy</a></li>
      <li><a href="#changes">9. Changes to this policy</a></li>
      <li><a href="#contact">10. Contact us</a></li>
    </ol>
  </nav>

  <main>
    <p class="pp-intro">
      AMA Quality Consulting ("AMA," "we," "us," or "our") helps DMEPOS suppliers become accreditation-ready, enrollment-ready, and survey-ready. This Privacy Policy explains what personal information we collect through {{ shop.url }} and our related forms, ads, and services, how we use it, and the choices available to you.
    </p>

    <section class="pp-item" id="collect">
      <div class="pp-item-head"><span class="pp-badge">1</span><h2>Information we collect</h2></div>
      <div class="pp-item-body">
        <ul>
          <li><strong>Information you provide:</strong> name, email address, phone number, business name, and any details you submit through our contact forms, lead forms (including Meta/Facebook and Instagram Instant Forms), checklist or resource downloads, or when you purchase a product or service from us.</li>
          <li><strong>Information collected automatically:</strong> IP address, browser and device type, pages viewed, and referral source, collected through cookies, pixels, and similar technologies when you visit our site.</li>
          <li><strong>Information from third parties:</strong> if you respond to one of our ads on Meta platforms, Meta shares the information you submitted in that ad's form with us.</li>
        </ul>
      </div>
    </section>

    <section class="pp-item" id="use">
      <div class="pp-item-head"><span class="pp-badge">2</span><h2>How we use your information</h2></div>
      <div class="pp-item-body">
        <ul>
          <li>To respond to your inquiries and deliver the checklists, readiness reviews, or consulting services you request</li>
          <li>To follow up about DMEPOS accreditation, enrollment, and compliance topics relevant to what you asked about (you can opt out of marketing messages at any time)</li>
          <li>To process orders and payments for products such as our policy and procedure manuals</li>
          <li>To maintain, secure, and improve our website and marketing</li>
          <li>To comply with legal and regulatory obligations</li>
        </ul>
      </div>
    </section>

    <section class="pp-item" id="cookies">
      <div class="pp-item-head"><span class="pp-badge">3</span><h2>Cookies &amp; advertising technologies</h2></div>
      <div class="pp-item-body">
        <p>We use cookies and similar tools, including the Meta Pixel and/or Conversions API, to measure how our ads perform and understand how visitors use our site. These tools may collect information about your browsing activity across sites and devices, and this activity may be treated as "sharing" or "targeted advertising" under some state privacy laws even though we do not sell data for money.</p>
        <p>You can control cookies through your browser settings. Where required by law, we honor recognized opt-out preference signals such as Global Privacy Control (GPC).</p>
      </div>
    </section>

    <section class="pp-item" id="share">
      <div class="pp-item-head"><span class="pp-badge">4</span><h2>How we share your information</h2></div>
      <div class="pp-item-body">
        <p>We do not sell your personal information. We may share it with:</p>
        <ul>
          <li>Service providers who help us run our business, such as our customer relationship management platform (currently GoHighLevel), workflow automation tools (currently Make.com), email/SMS delivery providers, and payment processors</li>
          <li>Meta Platforms, Inc., in connection with lead form submissions and advertising performance</li>
          <li>Our e-commerce and payment platform (e.g., Shopify and its integrated payment processor) if you purchase a product from us - we do not store full payment card numbers ourselves</li>
          <li>Professional advisors, regulators, or courts where required by law</li>
          <li>A successor entity in the event of a merger, acquisition, or sale of business assets</li>
        </ul>
      </div>
    </section>

    <section class="pp-item" id="rights">
      <div class="pp-item-head"><span class="pp-badge">5</span><h2>Your privacy rights</h2></div>
      <div class="pp-item-body">
        <p>Depending on where you live, state privacy laws (such as those in California, Colorado, Connecticut, and other states) may give you the right to access, correct, delete, or obtain a copy of your personal information, and to opt out of certain uses including targeted advertising.</p>
        <p>To exercise any of these rights, contact us at <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>. We will respond within the timeframe required by applicable law.</p>
      </div>
    </section>

    <section class="pp-item" id="retention">
      <div class="pp-item-head"><span class="pp-badge">6</span><h2>Data retention</h2></div>
      <div class="pp-item-body">
        <p>We retain personal information for as long as reasonably necessary to fulfill the purposes described in this policy, maintain business and tax records, and meet our legal obligations.</p>
      </div>
    </section>

    <section class="pp-item" id="security">
      <div class="pp-item-head"><span class="pp-badge">7</span><h2>Data security</h2></div>
      <div class="pp-item-body">
        <p>We use reasonable administrative, technical, and physical safeguards designed to protect your personal information. No method of transmission or storage is completely secure, and we cannot guarantee absolute security.</p>
      </div>
    </section>

    <section class="pp-item" id="children">
      <div class="pp-item-head"><span class="pp-badge">8</span><h2>Children's privacy</h2></div>
      <div class="pp-item-body">
        <p>Our website and services are directed to business professionals and are not intended for children under 13. We do not knowingly collect personal information from children.</p>
      </div>
    </section>

    <section class="pp-item" id="changes">
      <div class="pp-item-head"><span class="pp-badge">9</span><h2>Changes to this policy</h2></div>
      <div class="pp-item-body">
        <p>We may update this Privacy Policy from time to time. The effective date at the top of this page reflects the most recent revision. Continued use of our website after changes take effect means you accept the updated policy.</p>
      </div>
    </section>

    <section class="pp-item" id="contact">
      <div class="pp-item-head"><span class="pp-badge">10</span><h2>Contact us</h2></div>
      <address class="pp-contact">
        <span class="pp-fill">[Company Legal Name]</span><br>
        <span class="pp-fill">[Business Street Address, City, State, ZIP]</span><br>
        <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a><br>
        <a href="tel:{{ settings.phone_tel }}">{{ settings.phone_display }}</a>
      </address>
    </section>
  </main>
</div>
