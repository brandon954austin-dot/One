<section class="section">
  <div class="container center" style="padding-block: 4rem;">
    <div aria-hidden="true" style="margin-bottom: 1.2rem;">
      <svg width="88" height="88" viewBox="0 0 48 48" fill="none">
        <defs>
          <linearGradient id="e404Navy" x1="12" y1="14" x2="18" y2="32" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#10154f"/>
            <stop offset="1" stop-color="#1d2a9e"/>
          </linearGradient>
          <linearGradient id="e404Blue" x1="21" y1="14" x2="19" y2="27" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#2f45f0"/>
            <stop offset="1" stop-color="#2438cf"/>
          </linearGradient>
          <linearGradient id="e404Green" x1="34" y1="10" x2="18" y2="33" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#38df85"/>
            <stop offset="0.75" stop-color="#2bd473"/>
            <stop offset="1" stop-color="#25c4a0"/>
          </linearGradient>
        </defs>
        <path d="M12.5 18.5 L19 31.5" stroke="url(#e404Navy)" stroke-width="11.5" stroke-linecap="round"/>
        <path d="M20.5 16 L20 23" stroke="url(#e404Blue)" stroke-width="12.5" stroke-linecap="round"/>
        <path d="M33.5 13 L19.5 31.5" stroke="url(#e404Green)" stroke-width="13" stroke-linecap="round"/>
      </svg>
    </div>
    <span class="eyebrow">404</span>
    <h1>That page doesn't exist</h1>
    <p class="lede" style="margin-inline: auto;">The link may be outdated. Here's where to go instead:</p>
    <div class="btn-row" style="justify-content: center;">
      <a href="{{ routes.root_url }}" class="btn btn--primary">Homepage</a>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">Shop Programs</a>
      {%- if settings.calendly_url != blank -%}
        <a href="{{ settings.calendly_url }}" class="btn btn--outline" target="_blank" rel="noopener">Book a Call</a>
      {%- endif -%}
    </div>
  </div>
</section>
