{% layout 'landing' %}

{%- comment -%}
  Lead-funnel landing page. Assign in the Shopify admin:
  Online Store → Pages → (your landing page) → Theme template → "page.landing".
  Every CTA scrolls to the lead form; after submission the thank-you state
  pushes the Calendly booking link. Header/footer are the stripped-down
  "landing" layout so leads aren't distracted by site navigation.
{%- endcomment -%}

<style>
  .lp-hero {
    background:
      radial-gradient(900px 480px at 88% -8%, rgba(43, 212, 115, 0.18), transparent 60%),
      radial-gradient(700px 420px at -10% 110%, rgba(47, 69, 240, 0.22), transparent 55%),
      linear-gradient(160deg, var(--navy-900), var(--navy-950));
    color: #e8eef5;
    padding-block: clamp(2rem, 5vw, 3.25rem);
    overflow: hidden;
  }
  .lp-hero-grid { display: grid; gap: 1.8rem; align-items: start; grid-template-areas: "copy" "form" "extra"; }
  .lp-hero-copy { grid-area: copy; }
  .lp-hero-form { grid-area: form; }
  .lp-hero-extra { grid-area: extra; }
  @media (min-width: 920px) {
    .lp-hero-grid { grid-template-columns: 1.02fr 0.98fr; grid-template-areas: "copy form" "extra form"; column-gap: 3rem; row-gap: 1.5rem; }
  }
  .lp-hero h1 { color: #fff; max-width: 20ch; font-size: clamp(1.8rem, 3.6vw, 2.7rem); }
  .lp-hero .lede { color: #c3d2e2; }
  .lp-kicker {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(43, 212, 115, 0.14); border: 1px solid rgba(43, 212, 115, 0.35);
    color: #7cefc4; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 0.35rem 0.85rem; border-radius: 99px; margin-bottom: 1.1rem;
  }
  .lp-check-line { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 1.4rem; }
  .lp-check-line div { display: flex; gap: 0.6rem; align-items: flex-start; color: #d7e2ee; font-size: 1.02rem; }
  .lp-check-line svg { flex-shrink: 0; margin-top: 0.22em; }
  .lp-hero .btn--outline { color: #fff; border-color: #fff; }
  .lp-hero .btn--outline:hover { background: #fff; color: var(--navy-900); }

  /* Hero illustration: survey-ready binder scene */
  .lp-scene { position: relative; display: flex; justify-content: center; }
  .lp-scene svg { width: 100%; max-width: 430px; height: auto; filter: drop-shadow(0 24px 40px rgba(2, 8, 20, 0.45)); }

  .lp-pain { background: var(--bg-soft); }
  .lp-pain .card { border-top: 4px solid var(--teal-500); }
  .lp-pain .card h3 { display: flex; gap: 0.6rem; align-items: center; }

  .lp-band {
    background: linear-gradient(160deg, var(--navy-900), var(--navy-950));
    color: #e8eef5; border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 4vw, 3rem); display: grid; gap: 1.6rem;
  }
  @media (min-width: 860px) { .lp-band { grid-template-columns: auto 1fr auto; align-items: center; } }
  .lp-band h3 { color: #fff; margin: 0 0 0.2rem; }
  .lp-band p { color: #c3d2e2; margin: 0; }

  .lp-form-section {
    background:
      radial-gradient(800px 400px at 12% 0%, rgba(47, 69, 240, 0.14), transparent 60%),
      linear-gradient(160deg, var(--navy-950), var(--navy-900));
    color: #e8eef5;
  }
  .lp-form-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 920px) { .lp-form-grid { grid-template-columns: 1fr 460px; } }
  .lp-form-section h2 { color: #fff; }
  .lp-form-section .lede { color: #c3d2e2; }
  .lp-form-card { background: #fff; color: var(--ink); border-radius: var(--radius-lg); padding: clamp(1.4rem, 3vw, 2rem); box-shadow: 0 24px 60px rgba(2, 8, 20, 0.45); }
  .lp-form-card .form-grid { max-width: none; }
  .lp-form-card .form-grid > * { min-width: 0; }
  .lp-form-card select { min-width: 0; max-width: 100%; }
  .lp-form-card h3 { margin-bottom: 0.3rem; }
  .lp-form-card .form-sub { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 1.2rem; }
  .lp-privacy-note { font-size: 0.82rem; color: var(--ink-soft); margin: 0.8rem 0 0; }

  .lp-success { text-align: center; padding-block: 0.8rem; }
  .lp-success .lp-success-mark { margin-bottom: 0.8rem; }
  .lp-success h3 { font-size: 1.35rem; }

  .lp-book-divider { display: flex; align-items: center; gap: 0.8rem; color: var(--ink-soft); font-size: 0.85rem; margin: 1.3rem 0 1rem; }
  .lp-book-divider::before, .lp-book-divider::after { content: ""; flex: 1; height: 1px; background: var(--line); }

  .lp-reassure { margin: 0.9rem 0 0; font-size: 0.9rem; color: #9fb3c8; }

  .lp-2026 { background: var(--navy-800); color: #dfe8f1; padding-block: 1.1rem; font-size: 0.95rem; }
  .lp-2026-inner { display: flex; flex-wrap: wrap; gap: 0.5rem 2.2rem; align-items: center; }
  .lp-2026-inner strong { color: #7cefc4; font-weight: 700; }
  .lp-2026-inner span { display: inline-flex; align-items: center; gap: 0.5rem; }

  .lp-authority { display: flex; gap: 1rem; align-items: flex-start; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: var(--radius-lg); padding: 1.1rem 1.3rem; margin-top: 1.6rem; }
  .lp-authority svg { flex-shrink: 0; }
  .lp-authority p { margin: 0; font-size: 0.95rem; color: #c3d2e2; }
  .lp-authority strong { color: #fff; }

  .lp-faq details { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); margin-bottom: 0.7rem; box-shadow: var(--shadow-card); }
  .lp-faq summary { cursor: pointer; font-weight: 650; color: var(--navy-900); padding: 1rem 1.2rem; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .lp-faq summary::-webkit-details-marker { display: none; }
  .lp-faq summary::after { content: "+"; font-size: 1.3rem; font-weight: 400; color: var(--teal-600); flex-shrink: 0; }
  .lp-faq details[open] summary::after { content: "−"; }
  .lp-faq details p { margin: 0; padding: 0 1.2rem 1.1rem; color: var(--ink-soft); }

  .lp-sticky-cta {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 60;
    background: rgba(8, 27, 48, 0.97); backdrop-filter: blur(6px);
    padding: 0.65rem 1rem calc(0.65rem + env(safe-area-inset-bottom));
    transform: translateY(110%); transition: transform 0.25s ease;
  }
  .lp-sticky-cta.is-visible { transform: translateY(0); }
  .lp-sticky-cta .btn { display: block; width: 100%; text-align: center; }
  @media (min-width: 920px) { .lp-sticky-cta { display: none; } }

  @media (max-width: 560px) { .lp-header-phone { display: none; } }

  html { scroll-behavior: smooth; }
</style>

<!-- ============ HERO (with form) ============ -->
<section class="lp-hero">
  <div class="container lp-hero-grid">
    <div class="lp-hero-copy">
      <span class="lp-kicker">DMEPOS Accreditation &amp; Compliance</span>
      <h1>Pass your survey the first time - with a program built for <em>your</em> operation.</h1>
      <p class="lede">Custom DMEPOS compliance programs written around how you actually operate - professionally assembled and shipped to your door survey-ready.</p>
      <p class="lp-reassure">Free · takes 60 seconds · no obligation, no sales pressure</p>
    </div>

    <div class="lp-hero-form" id="lead-form">
      <div class="lp-form-card">
        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div class="lp-success">
              <div class="lp-success-mark">
                <svg width="64" height="64" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  <circle cx="24" cy="24" r="22" fill="rgba(43,212,115,0.16)"/>
                  <path d="M14 24.5l7 7 13-15" stroke="#25c4a0" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <h3>You're in - we'll be in touch within one business day.</h3>
              <p style="color: var(--ink-soft);">Want answers faster? Grab a time on the calendar and let's talk it through.</p>
              {%- if settings.calendly_url != blank -%}
                <a href="{{ settings.calendly_url }}" class="btn btn--primary btn--lg btn--full" target="_blank" rel="noopener">Book My Free Call Now</a>
              {%- endif -%}
              {%- if settings.phone_display != blank -%}
                <p style="margin: 1rem 0 0; font-size: 0.95rem;">Or call us directly: <a href="tel:{{ settings.phone_tel }}"><strong>{{ settings.phone_display }}</strong></a></p>
              {%- endif -%}
            </div>
          {%- else -%}
            <h3>Get your free readiness review</h3>
            <p class="form-sub">Takes about 60 seconds. No obligation.</p>

            {%- if form.errors -%}
              <div class="form-errors">
                <strong>Please fix the following:</strong>
                <ul>
                  {%- for field in form.errors -%}
                    <li>{{ form.errors.messages[field] }}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}

            <div class="form-grid">
              <div class="form-field">
                <label for="lead-name">Your name</label>
                <input type="text" id="lead-name" name="contact[name]" required autocomplete="name">
              </div>
              <div class="form-field">
                <label for="lead-company">Business name</label>
                <input type="text" id="lead-company" name="contact[business_name]" autocomplete="organization">
              </div>
              <div class="form-field">
                <label for="lead-email">Email</label>
                <input type="email" id="lead-email" name="contact[email]" required autocomplete="email">
              </div>
              <div class="form-field">
                <label for="lead-phone">Phone</label>
                <input type="tel" id="lead-phone" name="contact[phone]" autocomplete="tel">
              </div>
              <div class="form-field">
                <label for="lead-status">Which best describes you?</label>
                <select id="lead-status" name="contact[supplier_status]">
                  <option>New supplier - getting accredited for the first time</option>
                  <option>Existing supplier - reaccreditation coming up</option>
                  <option>Existing supplier - compliance program needs work</option>
                  <option>Just exploring options</option>
                </select>
              </div>
              <div>
                <button type="submit" class="btn btn--primary btn--lg btn--full">Get My Free Review</button>
              </div>
            </div>

            {%- if settings.calendly_url != blank -%}
              <div class="lp-book-divider">or skip the form</div>
              <a href="{{ settings.calendly_url }}" class="btn btn--outline btn--full" target="_blank" rel="noopener">Book a Free Call Now</a>
            {%- endif -%}
            <p class="lp-privacy-note">We respond within one business day. Please don't include patient information (PHI). By submitting you agree to our <a href="/pages/privacy-policy">privacy policy</a>.</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>

    <div class="lp-hero-extra">
      <p style="font-weight: 650; color: #fff; margin-bottom: 0.7rem;">Within one business day, you'll have:</p>
      <div class="lp-check-line" style="margin-top: 0;">
        <div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="rgba(43,212,115,0.18)"/><path d="M6 10.5l2.6 2.6L14.5 7" stroke="#2bd473" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>Your top readiness gaps</strong> - policies, training, site readiness, and enrollment</span>
        </div>
        <div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="rgba(43,212,115,0.18)"/><path d="M6 10.5l2.6 2.6L14.5 7" stroke="#2bd473" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>What the 2026 rules mean for you</strong> - annual resurveys, new locations, ownership changes</span>
        </div>
        <div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="rgba(43,212,115,0.18)"/><path d="M6 10.5l2.6 2.6L14.5 7" stroke="#2bd473" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>A straight answer on your timeline</strong> - and exactly what to fix first</span>
        </div>
      </div>
      <div class="lp-authority">
        <svg width="44" height="44" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <circle cx="24" cy="24" r="22" fill="rgba(43,212,115,0.15)"/>
          <path d="M14 24.5l7 7 13-15" stroke="#2bd473" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <p><strong>Who you'll hear from:</strong> a DMEPOS industry veteran with 30+ years in supplier operations and compliance - not a call center, not a sales script.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ 2026 URGENCY STRIP ============ -->
<div class="lp-2026">
  <div class="container lp-2026-inner">
    <strong>New for 2026:</strong>
    <span>Reaccreditation is now annual - the 3-year cycle is gone</span>
    <span>New locations must pass a survey before accreditation</span>
    <span>Accreditation doesn't transfer after ownership changes</span>
  </div>
</div>

<!-- ============ PAIN / STAKES ============ -->
<section class="section lp-pain">
  <div class="container">
    <span class="eyebrow">Why it matters</span>
    <h2>An unprepared survey doesn't just fail - it stops your billing.</h2>
    <div class="grid grid--3" style="margin-top: 1.8rem;">
      <div class="card">
        <h3><span aria-hidden="true">⚠️</span> Generic templates get flagged</h3>
        <p>Surveyors can tell when a compliance manual doesn't match the operation in front of them. Boilerplate that contradicts your actual workflow is a finding waiting to happen.</p>
      </div>
      <div class="card">
        <h3><span aria-hidden="true">⏱️</span> Deadlines don't wait</h3>
        <p>Accreditation, reaccreditation, and enrollment windows are unforgiving. Every week without a survey-ready program is a week of revenue at risk.</p>
      </div>
      <div class="card">
        <h3><span aria-hidden="true">📋</span> DIY costs more than it saves</h3>
        <p>Writing policies from scratch while running a supply business means late nights and blind spots. One missed standard can cost far more than doing it right the first time.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="section">
  <div class="container">
    <span class="eyebrow">How it works</span>
    <h2>From first call to survey-ready binder</h2>
    <div class="grid grid--3" style="margin-top: 1.8rem;">
      <div class="card">
        <div class="step-num">1</div>
        <h3>Tell us where you stand</h3>
        <p>Fill out the quick form at the top of the page (or book a call directly). We'll review your situation - new supplier, accreditation renewal, or compliance cleanup - for free.</p>
      </div>
      <div class="card">
        <div class="step-num">2</div>
        <h3>We build your program</h3>
        <p>A structured intake captures your products, staffing, and workflows so your program reflects reality, not boilerplate. Fixed price - no hourly billing.</p>
      </div>
      <div class="card">
        <div class="step-num">3</div>
        <h3>Open the box, pass the survey</h3>
        <p>Your program arrives written, professionally printed, and assembled - organized exactly the way a surveyor expects to see it.</p>
      </div>
    </div>

    <div class="lp-band" style="margin-top: 2.4rem;">
      <svg width="54" height="54" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <circle cx="24" cy="24" r="22" fill="rgba(43,212,115,0.15)"/>
        <path d="M14 24.5l7 7 13-15" stroke="#2bd473" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div>
        <h3>Free readiness review - no pressure, no obligation.</h3>
        <p>Fifteen minutes to find out exactly where your operation stands and what it takes to get survey-ready.</p>
      </div>
      <a href="#lead-form" class="btn btn--primary btn--lg">Get My Free Review ↑</a>
    </div>
  </div>
</section>

<!-- ============ FAQ / OBJECTIONS ============ -->
<section class="section section--soft lp-faq">
  <div class="container" style="max-width: 780px;">
    <span class="eyebrow">Common questions</span>
    <h2>Before you ask...</h2>
    <div style="margin-top: 1.6rem;">
      <details>
        <summary>Is the readiness review really free?</summary>
        <p>Yes. It's a short, focused review of where your operation stands - your timeline, your risk areas, and what it would take to close the gaps. You leave with that picture whether or not you ever hire us. No obligation, no pressure.</p>
      </details>
      <details>
        <summary>We already have a policy manual. Do we still need this?</summary>
        <p>A binder on the shelf isn't the test anymore. With annual reaccreditation, surveyors check whether your day-to-day operations actually match your written program - document control, staff training, site readiness. That's exactly what the review looks at.</p>
      </details>
      <details>
        <summary>Do you guarantee accreditation?</summary>
        <p>No one can honestly guarantee accreditation or Medicare billing privileges - accrediting organizations and enrollment contractors decide independently. What we do is help you identify and correct readiness gaps, prepare documentation, and strengthen operational compliance so you walk into the survey prepared.</p>
      </details>
      <details>
        <summary>How fast can we get survey-ready?</summary>
        <p>It depends on the gaps. Some suppliers need a few targeted fixes; others need a full program built. The readiness review gives you a realistic timeline for your situation - that's the point of doing it before committing to anything.</p>
      </details>
    </div>
  </div>
</section>

<!-- Mobile sticky CTA: appears after scrolling past the hero, hides at the form -->
<div class="lp-sticky-cta" id="lp-sticky-cta" aria-hidden="true">
  <a href="#lead-form" class="btn btn--primary">Get My Free Readiness Review</a>
</div>

<script>
  // After a successful submit Shopify reloads the page; jump to the
  // thank-you card so the lead sees the booking CTA immediately, and
  // fire the Meta Pixel Lead event exactly once per submission.
  if (window.location.search.indexOf('contact_posted=true') !== -1) {
    document.getElementById('lead-form').scrollIntoView();
    if (typeof fbq === 'function' && !sessionStorage.getItem('ama_lead_fired')) {
      fbq('track', 'Lead', { content_name: {{ page.title | default: 'Landing page' | json }} });
      sessionStorage.setItem('ama_lead_fired', '1');
    }
  }

  // Mobile sticky CTA: show once the hero has scrolled away,
  // hide while the lead form itself is on screen.
  (function () {
    var bar = document.getElementById('lp-sticky-cta');
    var hero = document.querySelector('.lp-hero');
    var formSection = document.getElementById('lead-form');
    if (!bar || !hero || !formSection || !('IntersectionObserver' in window)) return;
    var pastHero = false, formVisible = false;
    var update = function () {
      bar.classList.toggle('is-visible', pastHero && !formVisible);
    };
    new IntersectionObserver(function (entries) {
      pastHero = !entries[0].isIntersecting;
      update();
    }).observe(hero);
    new IntersectionObserver(function (entries) {
      formVisible = entries[0].isIntersecting;
      update();
    }, { rootMargin: '0px 0px -30% 0px' }).observe(formSection);
  })();
</script>
