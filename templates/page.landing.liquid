{% layout 'landing' %}

{%- comment -%}
  Lead-funnel landing page. Assign in the Shopify admin:
  Online Store → Pages → (your landing page) → Theme template → "page.landing".
  Every CTA scrolls to the lead form; after submission the thank-you state
  pushes the Calendly booking link. Header/footer are the stripped-down
  "landing" layout so leads aren't distracted by site navigation.
{%- endcomment -%}

<style>
  .lp-hero {
    background:
      radial-gradient(900px 480px at 88% -8%, rgba(43, 212, 115, 0.18), transparent 60%),
      radial-gradient(700px 420px at -10% 110%, rgba(47, 69, 240, 0.22), transparent 55%),
      linear-gradient(160deg, var(--navy-900), var(--navy-950));
    color: #e8eef5;
    padding-block: clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }
  .lp-hero-grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 920px) { .lp-hero-grid { grid-template-columns: 1.15fr 0.85fr; } }
  .lp-hero h1 { color: #fff; max-width: 20ch; }
  .lp-hero .lede { color: #c3d2e2; }
  .lp-kicker {
    display: inline-flex; align-items: center; gap: 0.5rem;
    background: rgba(43, 212, 115, 0.14); border: 1px solid rgba(43, 212, 115, 0.35);
    color: #7cefc4; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 0.35rem 0.85rem; border-radius: 99px; margin-bottom: 1.1rem;
  }
  .lp-check-line { display: flex; flex-direction: column; gap: 0.55rem; margin-top: 1.4rem; }
  .lp-check-line div { display: flex; gap: 0.6rem; align-items: flex-start; color: #d7e2ee; font-size: 1.02rem; }
  .lp-check-line svg { flex-shrink: 0; margin-top: 0.22em; }
  .lp-hero .btn--outline { color: #fff; border-color: #fff; }
  .lp-hero .btn--outline:hover { background: #fff; color: var(--navy-900); }

  /* Hero illustration: survey-ready binder scene */
  .lp-scene { position: relative; display: flex; justify-content: center; }
  .lp-scene svg { width: 100%; max-width: 430px; height: auto; filter: drop-shadow(0 24px 40px rgba(2, 8, 20, 0.45)); }

  .lp-pain { background: var(--bg-soft); }
  .lp-pain .card { border-top: 4px solid var(--teal-500); }
  .lp-pain .card h3 { display: flex; gap: 0.6rem; align-items: center; }

  .lp-band {
    background: linear-gradient(160deg, var(--navy-900), var(--navy-950));
    color: #e8eef5; border-radius: var(--radius-lg);
    padding: clamp(1.8rem, 4vw, 3rem); display: grid; gap: 1.6rem;
  }
  @media (min-width: 860px) { .lp-band { grid-template-columns: auto 1fr auto; align-items: center; } }
  .lp-band h3 { color: #fff; margin: 0 0 0.2rem; }
  .lp-band p { color: #c3d2e2; margin: 0; }

  .lp-form-section {
    background:
      radial-gradient(800px 400px at 12% 0%, rgba(47, 69, 240, 0.14), transparent 60%),
      linear-gradient(160deg, var(--navy-950), var(--navy-900));
    color: #e8eef5;
  }
  .lp-form-grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 920px) { .lp-form-grid { grid-template-columns: 1fr 460px; } }
  .lp-form-section h2 { color: #fff; }
  .lp-form-section .lede { color: #c3d2e2; }
  .lp-form-card { background: #fff; color: var(--ink); border-radius: var(--radius-lg); padding: clamp(1.4rem, 3vw, 2rem); box-shadow: 0 24px 60px rgba(2, 8, 20, 0.45); }
  .lp-form-card .form-grid { max-width: none; }
  .lp-form-card .form-grid > * { min-width: 0; }
  .lp-form-card select { min-width: 0; max-width: 100%; }
  .lp-form-card h3 { margin-bottom: 0.3rem; }
  .lp-form-card .form-sub { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 1.2rem; }
  .lp-privacy-note { font-size: 0.82rem; color: var(--ink-soft); margin: 0.8rem 0 0; }

  .lp-success { text-align: center; padding-block: 0.8rem; }
  .lp-success .lp-success-mark { margin-bottom: 0.8rem; }
  .lp-success h3 { font-size: 1.35rem; }

  .lp-book-divider { display: flex; align-items: center; gap: 0.8rem; color: var(--ink-soft); font-size: 0.85rem; margin: 1.3rem 0 1rem; }
  .lp-book-divider::before, .lp-book-divider::after { content: ""; flex: 1; height: 1px; background: var(--line); }

  html { scroll-behavior: smooth; }
</style>

<!-- ============ HERO ============ -->
<section class="lp-hero">
  <div class="container lp-hero-grid">
    <div>
      <span class="lp-kicker">DMEPOS Accreditation &amp; Compliance</span>
      <h1>Pass your survey the first time — with a program built for <em>your</em> operation.</h1>
      <p class="lede">Custom DMEPOS compliance programs and accreditation packages, written around how you actually operate — professionally assembled and shipped to your door survey-ready.</p>
      <div class="lp-check-line">
        <div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="rgba(43,212,115,0.18)"/><path d="M6 10.5l2.6 2.6L14.5 7" stroke="#2bd473" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>30+ years</strong> of DMEPOS industry experience on your side</span>
        </div>
        <div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="rgba(43,212,115,0.18)"/><path d="M6 10.5l2.6 2.6L14.5 7" stroke="#2bd473" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>100% custom</strong> — written around your products, staff, and workflows</span>
        </div>
        <div>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="9" fill="rgba(43,212,115,0.18)"/><path d="M6 10.5l2.6 2.6L14.5 7" stroke="#2bd473" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span><strong>Delivered done</strong> — printed, assembled, and shipped ready for the surveyor</span>
        </div>
      </div>
      <div class="btn-row">
        <a href="#lead-form" class="btn btn--primary btn--lg">Get My Free Readiness Review</a>
        {%- if settings.calendly_url != blank -%}
          <a href="{{ settings.calendly_url }}" class="btn btn--outline btn--lg" target="_blank" rel="noopener">Book a Call Instead</a>
        {%- endif -%}
      </div>
    </div>

    <div class="lp-scene" aria-hidden="true">
      <!-- Survey-ready binder illustration -->
      <svg viewBox="0 0 440 400" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="lpCover" x1="90" y1="60" x2="330" y2="360" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#13315c"/>
            <stop offset="1" stop-color="#0b2545"/>
          </linearGradient>
          <linearGradient id="lpSpine" x1="70" y1="60" x2="70" y2="360" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#1d2a9e"/>
            <stop offset="1" stop-color="#10154f"/>
          </linearGradient>
          <linearGradient id="lpBadge" x1="290" y1="260" x2="390" y2="360" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#38df85"/>
            <stop offset="1" stop-color="#25c4a0"/>
          </linearGradient>
          <linearGradient id="lpTab1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#2f45f0"/><stop offset="1" stop-color="#2438cf"/>
          </linearGradient>
        </defs>

        <!-- pages behind -->
        <rect x="96" y="70" width="252" height="300" rx="10" fill="#e9eef5"/>
        <rect x="90" y="64" width="252" height="300" rx="10" fill="#f6f9fc"/>

        <!-- binder cover -->
        <rect x="82" y="56" width="252" height="304" rx="12" fill="url(#lpCover)"/>
        <rect x="66" y="56" width="30" height="304" rx="10" fill="url(#lpSpine)"/>
        <circle cx="81" cy="120" r="5" fill="#0a1330"/>
        <circle cx="81" cy="208" r="5" fill="#0a1330"/>
        <circle cx="81" cy="296" r="5" fill="#0a1330"/>

        <!-- cover content -->
        <g transform="translate(120, 92)">
          <path d="M8 12 L14 25" stroke="#2f45f0" stroke-width="11" stroke-linecap="round"/>
          <path d="M28 7 L15 25" stroke="#2bd473" stroke-width="12" stroke-linecap="round"/>
          <rect x="46" y="4" width="120" height="10" rx="5" fill="#ffffff" opacity="0.92"/>
          <rect x="46" y="21" width="84" height="8" rx="4" fill="#8fa8c7"/>
        </g>
        <rect x="120" y="150" width="176" height="7" rx="3.5" fill="#3d5a80"/>
        <rect x="120" y="167" width="150" height="7" rx="3.5" fill="#3d5a80"/>
        <rect x="120" y="184" width="163" height="7" rx="3.5" fill="#3d5a80"/>

        <!-- checklist rows on cover -->
        <g transform="translate(120, 214)">
          <circle cx="10" cy="10" r="10" fill="rgba(43,212,115,0.2)"/>
          <path d="M5.5 10.5l3 3 6.5-7" stroke="#2bd473" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="30" y="5" width="120" height="9" rx="4.5" fill="#22406b"/>
        </g>
        <g transform="translate(120, 248)">
          <circle cx="10" cy="10" r="10" fill="rgba(43,212,115,0.2)"/>
          <path d="M5.5 10.5l3 3 6.5-7" stroke="#2bd473" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="30" y="5" width="140" height="9" rx="4.5" fill="#22406b"/>
        </g>
        <g transform="translate(120, 282)">
          <circle cx="10" cy="10" r="10" fill="rgba(43,212,115,0.2)"/>
          <path d="M5.5 10.5l3 3 6.5-7" stroke="#2bd473" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="30" y="5" width="104" height="9" rx="4.5" fill="#22406b"/>
        </g>

        <!-- index tabs -->
        <rect x="330" y="96" width="34" height="26" rx="6" fill="url(#lpTab1)"/>
        <rect x="330" y="136" width="34" height="26" rx="6" fill="#2bd473"/>
        <rect x="330" y="176" width="34" height="26" rx="6" fill="#12a5a0"/>
        <rect x="330" y="216" width="34" height="26" rx="6" fill="#3d5a80"/>

        <!-- floating "Survey-Ready" badge -->
