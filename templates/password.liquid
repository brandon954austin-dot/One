<section class="hero" style="min-height: 100vh; display: flex; align-items: center;">
  <div class="container center" style="width: 100%;">
    <h1>{{ shop.name }}</h1>
    <p class="lede" style="margin-inline: auto;">We're getting things ready. Check back soon.</p>
    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <p style="color: #ffb4b4;">Incorrect password - please try again.</p>
      {%- endif -%}
      <div style="display: flex; gap: 0.6rem; justify-content: center; margin-top: 1.4rem; flex-wrap: wrap;">
        <input type="password" name="password" placeholder="Store password" aria-label="Store password" style="padding: 0.75rem 0.9rem; border-radius: 10px; border: none; font: inherit;">
        <button type="submit" class="btn btn--primary">Enter</button>
      </div>
    {% endform %}
  </div>
</section>
