<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {%- comment -%}
    Clean SEO title: no stray quote marks, one canonical brand name.
    Shopify appends nothing - we control the full title here.
  {%- endcomment -%}
  {%- if template == 'index' -%}
    {%- assign seo_title = shop.name | append: ' | DMEPOS Accreditation & Survey Readiness' -%}
  {%- else -%}
    {%- assign seo_title = page_title | strip | append: ' | ' | append: shop.name -%}
  {%- endif -%}
  {%- if page_description != blank -%}
    {%- assign seo_description = page_description | strip_html | truncate: 160 -%}
  {%- else -%}
    {%- assign seo_description = 'DMEPOS accreditation consulting: readiness reviews, CMS-855S enrollment support, corrective action help, and custom policy manuals. Become survey-ready, enrollment-ready, and audit-defensible.' -%}
  {%- endif -%}

  <title>{{ seo_title }}</title>
  <meta name="description" content="{{ seo_description | escape }}">

  <link rel="canonical" href="{{ canonical_url }}">

  {%- comment -%} Social sharing (Open Graph + Twitter) {%- endcomment -%}
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:description" content="{{ seo_description | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {%- if template contains 'product' and product.featured_image -%}
    <meta property="og:type" content="product">
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:type" content="website">
    <meta property="og:image" content="{{ 'social-banner.png' | asset_url }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">

  {%- comment -%} Organization structured data for search engines {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "image": {{ 'social-banner.png' | asset_url | json }},
    "description": "DMEPOS accreditation and compliance consulting for durable medical equipment suppliers: readiness reviews, CMS-855S enrollment support, corrective action plans, and custom policy and procedure manuals.",
    {%- if settings.phone_tel != blank -%}
    "telephone": {{ settings.phone_tel | json }},
    {%- endif -%}
    {%- if settings.contact_email != blank -%}
    "email": {{ settings.contact_email | json }},
    {%- endif -%}
    "priceRange": "$$",
    "knowsAbout": ["DMEPOS accreditation", "CMS-855S Medicare enrollment", "DMEPOS supplier standards", "corrective action plans", "annual reaccreditation", "compliance policy manuals"]
  }
  </script>
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

  {% render 'meta-pixel' %}
  {{ content_for_header }}
</head>
<body>

  <header class="site-header">
    <div class="container site-header__inner">
      <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name }} - home">
        <svg width="34" height="34" viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <defs>
            <linearGradient id="amaNavy" x1="12" y1="14" x2="18" y2="32" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#10154f"/>
              <stop offset="1" stop-color="#1d2a9e"/>
            </linearGradient>
            <linearGradient id="amaBlue" x1="21" y1="14" x2="19" y2="27" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#2f45f0"/>
              <stop offset="1" stop-color="#2438cf"/>
            </linearGradient>
            <linearGradient id="amaGreen" x1="34" y1="10" x2="18" y2="33" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#38df85"/>
              <stop offset="0.75" stop-color="#2bd473"/>
              <stop offset="1" stop-color="#25c4a0"/>
            </linearGradient>
          </defs>
          <path d="M12.5 18.5 L19 31.5" stroke="url(#amaNavy)" stroke-width="11.5" stroke-linecap="round"/>
          <path d="M20.5 16 L20 23" stroke="url(#amaBlue)" stroke-width="12.5" stroke-linecap="round"/>
          <path d="M33.5 13 L19.5 31.5" stroke="url(#amaGreen)" stroke-width="13" stroke-linecap="round"/>
        </svg>
        <span>{{ shop.name }}</span>
      </a>

      <button class="nav-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="site-nav">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
        </svg>
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Main navigation">
        {%- for link in linklists.main-menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
        <a href="{{ routes.cart_url }}" class="cart-link">
          Cart{% if cart.item_count > 0 %} <span class="cart-count">{{ cart.item_count }}</span>{% endif %}
        </a>
        {%- if settings.calendly_url != blank -%}
          <a href="{{ settings.calendly_url }}" class="btn btn--primary" target="_blank" rel="noopener">Book a Call</a>
        {%- endif -%}
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content_for_layout }}
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <h4>{{ shop.name }}</h4>
          <p>Custom DMEPOS compliance programs, accreditation preparation, and implementation systems - built on 30+ years of industry experience.</p>
        </div>
        <div>
          <h4>Navigate</h4>
          <ul>
            {%- for link in linklists.main-menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
            <li><a href="{{ routes.all_products_collection_url }}">All programs</a></li>
          </ul>
        </div>
        <div>
          <h4>Get in touch</h4>
          <ul>
            {%- if settings.phone_display != blank -%}
              <li><a href="tel:{{ settings.phone_tel }}">{{ settings.phone_display }}</a></li>
            {%- endif -%}
            {%- if settings.contact_email != blank -%}
              <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
            {%- endif -%}
            {%- if settings.calendly_url != blank -%}
              <li><a href="{{ settings.calendly_url }}" target="_blank" rel="noopener">Book a Call</a></li>
            {%- endif -%}
          </ul>
        </div>
      </div>
      <div class="footer-legal">
        <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved. · <a href="/pages/privacy-policy">Privacy Policy</a> · <a href="/pages/refund-policy">Refund Policy</a></p>
        <p>{{ shop.name }} is an independent consulting firm and is not affiliated with, or endorsed by, the Centers for Medicare &amp; Medicaid Services (CMS) or any accrediting organization. Information on this site is general guidance, not legal advice.</p>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var toggle = document.querySelector('.nav-toggle');
      var nav = document.getElementById('site-nav');
      if (toggle && nav) {
        toggle.addEventListener('click', function () {
          var open = nav.classList.toggle('is-open');
          toggle.setAttribute('aria-expanded', String(open));
        });
      }
    })();
  </script>
</body>
</html>
